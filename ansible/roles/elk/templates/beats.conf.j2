# {{ ansible_managed }}
input {
  beats {
    host => "{{ elk_bind_host }}"
    port => {{ elk_beats_port }}
    # With ECS enabled (the default), codec_metadata copies the raw line into [event][original]. The apache
    # module's ingest pipeline sets that field itself and rejects the event if it exists ("field [event.original]
    # already exists"), so only source metadata is added here.
    enrich => [source_metadata]
  }
}

# Filebeat modules (such as apache) name an Elasticsearch ingest pipeline in [@metadata][pipeline];
# passing it on lets Elasticsearch parse the logs exactly as if Filebeat had sent them directly.
output {
  if [@metadata][pipeline] {
    elasticsearch {
      hosts => ["{{ elk_elasticsearch_url }}"]
      ssl_enabled => true
      ssl_certificate_authorities => ["/etc/logstash/certs/http_ca.crt"]
      user => "{{ elk_logstash_user }}"
      password => "{{ elk_logstash_writer_password }}"
      manage_template => false
      index => "%{[@metadata][beat]}-%{[@metadata][version]}"
      action => "create"
      pipeline => "%{[@metadata][pipeline]}"
    }
  } else {
    elasticsearch {
      hosts => ["{{ elk_elasticsearch_url }}"]
      ssl_enabled => true
      ssl_certificate_authorities => ["/etc/logstash/certs/http_ca.crt"]
      user => "{{ elk_logstash_user }}"
      password => "{{ elk_logstash_writer_password }}"
      manage_template => false
      index => "%{[@metadata][beat]}-%{[@metadata][version]}"
      action => "create"
    }
  }
}
