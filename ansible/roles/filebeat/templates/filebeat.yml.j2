# {{ ansible_managed }}
filebeat.config.modules:
  path: ${path.config}/modules.d/*.yml
  reload.enabled: false

processors:
  - add_host_metadata: ~
  - add_cloud_metadata: ~

# Events go to Logstash on the logging server; Logstash forwards them to Elasticsearch
# with the module's ingest pipeline.
output.logstash:
  hosts: ["{{ filebeat_elk_host }}:{{ filebeat_logstash_port }}"]
